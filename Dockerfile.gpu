# Dockerfile for GPU-Accelerated ML Trading System
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=0
ENV TF_CPP_MIN_LOG_LEVEL=2
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3-dev \
    build-essential \
    libssl-dev \
    libffi-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    git \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies with GPU support
RUN pip3 install --no-cache-dir \
    torch==2.1.0+cu121 torchvision==0.16.0+cu121 -f https://download.pytorch.org/whl/torch_stable.html \
    && pip3 install --no-cache-dir -r requirements.txt

# Create requirements.txt with GPU-optimized packages
RUN echo "# GPU-Optimized Requirements for ML Trading System\n\
# Core ML Libraries with GPU Support\n\
xgboost>=2.0.0  # GPU support via tree_method='gpu_hist'\n\
torch>=2.1.0  # Already installed with CUDA\n\
tensorflow>=2.14.0  # Optional, for additional models\n\
\n\
# Data Processing\n\
pandas>=2.0.0\n\
numpy>=1.24.0\n\
scikit-learn>=1.3.0\n\
ta-lib  # Technical analysis\n\
\n\
# Async and API\n\
aiohttp>=3.9.0\n\
asyncio>=3.4.3\n\
python-binance>=1.0.17\n\
ccxt>=4.0.0\n\
\n\
# Monitoring and Logging\n\
tensorboard>=2.14.0\n\
wandb>=0.15.0  # Experiment tracking\n\
prometheus-client>=0.18.0\n\
\n\
# Database\n\
motor>=3.3.0  # Async MongoDB\n\
redis>=5.0.0\n\
influxdb-client>=1.38.0  # Time series data\n\
\n\
# Utilities\n\
python-dotenv>=1.0.0\n\
joblib>=1.3.0\n\
tqdm>=4.66.0\n\
matplotlib>=3.7.0\n\
seaborn>=0.12.0\n\
plotly>=5.17.0\n\
\n\
# Performance\n\
numba>=0.58.0  # JIT compilation\n\
cupy>=12.0.0  # GPU arrays\n\
rapids-singlecell>=0.9.0  # RAPIDS for GPU DataFrames (optional)\
" > requirements_gpu.txt

# Copy application code
COPY . .

# Create directories
RUN mkdir -p logs models data checkpoints

# Expose ports
EXPOSE 8080 6006 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import torch; assert torch.cuda.is_available()"

# Set entrypoint
ENTRYPOINT ["python3", "-u"]
CMD ["main.py"] 