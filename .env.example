# AI-Driven Cryptocurrency Trading System
# Environment Configuration Template — copy to .env and fill in values

# === ENCRYPTION ===
ENCRYPTION_PASSWORD=

# === SYSTEM CONFIGURATION ===
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=
TZ=UTC
PYTHONPATH=/app/src
SYSTEM_ENV=production
LOG_LEVEL=INFO

# === DATABASE CONFIGURATION (local docker dev) ===
POSTGRES_USER=trader
POSTGRES_PASSWORD=
POSTGRES_DB=trading_db
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=

# === EXCHANGE API CREDENTIALS ===
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=true
OKX_API_KEY=
OKX_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=
COINBASE_SANDBOX=true
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# === MARKET DATA APIS ===
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=
FRED_API_KEY=

# Rate limits (requests per minute) — see docs for typical defaults
ALPHA_VANTAGE_RATE_LIMIT=
COINGECKO_RATE_LIMIT=
FRED_RATE_LIMIT=

# === TWITTER API CREDENTIALS ===
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# === TELEGRAM BOT ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_RATE_LIMIT=30
TELEGRAM_NOTIFICATIONS_ENABLED=false

# === TRADING CONFIGURATION ===
MAX_OPEN_TRADES=5
STAKE_AMOUNT=100
STAKE_CURRENCY=USDT
DRY_RUN=true
INITIAL_CAPITAL=500
TARGET_SYMBOLS=SOL,HYPE
PRIMARY_MARKET=USD
MAX_CONCURRENT_POSITIONS=3
MAX_POSITION_SIZE=0.15
TARGET_SHARPE_RATIO=2.0
MAX_DRAWDOWN=0.15

# === EXCHANGE RATE LIMITS (requests per minute) ===
BINANCE_RATE_LIMIT=1200
OKX_RATE_LIMIT=600
HYPERLIQUID_RATE_LIMIT=300

# === ML MODEL CONFIGURATION ===
VOLUME_CONTAMINATION=0.05
VOLUME_N_ESTIMATORS=100
MAML_INNER_LR=0.01
MAML_META_LR=0.001
MAML_INNER_STEPS=5
MAML_META_BATCH_SIZE=16
SENTIMENT_THRESHOLD=0.1
MAX_TWEETS_PER_HOUR=10000

# === MONITORING CONFIGURATION ===
GF_SECURITY_ADMIN_PASSWORD=
GF_USERS_ALLOW_SIGN_UP=false
PROMETHEUS_RETENTION_TIME=200h

# === LOGGING CONFIGURATION ===
LOG_FORMAT=json
LOG_FILE_MAX_SIZE=100MB
LOG_FILE_BACKUP_COUNT=5

# === SECURITY CONFIGURATION ===
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# === EXTERNAL SERVICES ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
NEWS_API_KEY=

# === PERFORMANCE TUNING ===
WORKER_PROCESSES=4
WORKER_THREADS=2
WORKER_TIMEOUT=30
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true

# === DEVELOPMENT CONFIGURATION ===
JUPYTER_TOKEN=
JUPYTER_PORT=8888
RELOAD_ON_CHANGE=true
RELOAD_DIRS=src/

# === RISK MANAGEMENT ===
KELLY_CRITERION_ENABLED=true
MAX_DAILY_TRADES=10
STOP_LOSS_PERCENTAGE=0.05
TAKE_PROFIT_PERCENTAGE=0.15
HISTORICAL_DATA_DAYS=365
SENTIMENT_ANALYSIS_ENABLED=true
VOLUME_ANOMALY_DETECTION_ENABLED=true
MACRO_REGIME_DETECTION_ENABLED=true
SIGNAL_ALERT_THRESHOLD=0.7
PERFORMANCE_REPORT_INTERVAL=24
ENSEMBLE_LEARNING_ENABLED=true
MODEL_RETRAINING_INTERVAL=168
FEATURE_SELECTION_ENABLED=true

# === BACKUP CONFIGURATION ===
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === ALERTS CONFIGURATION ===
ALERT_ON_LARGE_LOSS=true
ALERT_LOSS_THRESHOLD=-0.05
ALERT_ON_HIGH_VOLATILITY=true
ALERT_VOLATILITY_THRESHOLD=0.1
ALERT_ON_HIGH_CPU=true
ALERT_CPU_THRESHOLD=80
ALERT_ON_HIGH_MEMORY=true
ALERT_MEMORY_THRESHOLD=85

# === FEATURE FLAGS ===
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_VOLUME_ANOMALY_DETECTION=true
ENABLE_META_LEARNING=true
ENABLE_REGIME_DETECTION=true
ENABLE_TELEGRAM_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
